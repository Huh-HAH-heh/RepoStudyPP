<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="StudyMauiApp.AddAnimalPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Добавить животное"
    BackgroundColor="#F3F4F4">

    <ScrollView>
        <VerticalStackLayout Padding="18" Spacing="14">
            <VerticalStackLayout Spacing="3">
                <Label Text="Новое животное"
                       FontSize="23"
                       FontAttributes="Bold"
                       TextColor="#252525" />
                <Label Text="Заполните основные сведения для журнала приюта."
                       FontSize="13"
                       TextColor="#666666" />
            </VerticalStackLayout>

            <Border BackgroundColor="White"
                    Stroke="#D6D6D6"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 5"
                    Padding="16">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Кличка *" FontSize="13" TextColor="#555555" />
                    <Entry x:Name="NameEntry" Placeholder="Например: Белка" />

                    <Label Text="Номер *" FontSize="13" TextColor="#555555" />
                    <Entry x:Name="NumberEntry" Placeholder="Например: A-130" />

                    <Label Text="Вид животного *" FontSize="13" TextColor="#555555" />
                    <Entry x:Name="SpeciesEntry" Placeholder="Собака или кошка" />

                    <Label Text="Пол *" FontSize="13" TextColor="#555555" />
                    <Entry x:Name="GenderEntry" Placeholder="Самец или самка" />

                    <Label Text="Порода" FontSize="13" TextColor="#555555" />
                    <Entry x:Name="BreedEntry" Placeholder="Можно не заполнять" />

                    <Label Text="Размер *" FontSize="13" TextColor="#555555" />
                    <Entry x:Name="SizeEntry" Placeholder="Маленький, средний или крупный" />

                    <Label Text="Дата поступления" FontSize="13" TextColor="#555555" />
                    <DatePicker x:Name="AdmissionDatePicker"
                                Format="dd.MM.yyyy" />

                    <Label x:Name="ValidationLabel"
                           IsVisible="False"
                           TextColor="#B33A3A"
                           FontSize="12" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button Text="Отмена"
                                Clicked="OnCancelClicked"
                                BackgroundColor="#E1E4E5"
                                TextColor="#252525"
                                CornerRadius="4"
                                HeightRequest="42" />
                        <Button Grid.Column="1"
                                Text="Сохранить"
                                Clicked="OnSaveClicked"
                                BackgroundColor="#456C83"
                                TextColor="White"
                                CornerRadius="4"
                                HeightRequest="42" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>