@page "/login"
@inject UserSession Session
@inject NavigationManager Navigation

<PageTitle>Вход</PageTitle>

<div class="narrow-page">
    <section class="card">
        <h1>Вход в систему</h1>
        <p class="muted">Введите логин и пароль учебной учётной записи.</p>
        <div class="form">
            <label for="login">Логин</label>
            <input id="login" @bind="Login" autocomplete="username" />
            <label for="password">Пароль</label>
            <input id="password" type="password" @bind="Password" autocomplete="current-password" />
            @if (!string.IsNullOrWhiteSpace(Error))
            {
                <p class="error">@Error</p>
            }
            <button class="button" @onclick="SignIn">Войти</button>
        </div>
    </section>

    <section class="card">
        <h2>Тестовые учётные записи</h2>
        <p><b>Администратор:</b> Nerd / Nerd</p>
        <p><b>Клиент:</b> GOON / GOON</p>
        <p><b>Волонтёр:</b> WERDO / WERDO</p>
        <p><b>Ветеринар:</b> vet / vet</p>
    </section>
</div>

@code {
    private string Login { get; set; } = "";
    private string Password { get; set; } = "";
    private string Error { get; set; } = "";

    private void SignIn()
    {
        if (Session.TryLogin(Login, Password))
        {
            Navigation.NavigateTo("/shelter");
            return;
        }

        Error = "Неверный логин или пароль.";
    }
}
