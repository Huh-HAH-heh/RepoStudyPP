@page "/reports"
@inject UserSession Session

<PageTitle>Отчёт</PageTitle>

<div class="page-heading">
    <h1>Отчёт приюта</h1>
    <p>Основные показатели по текущему списку животных.</p>
</div>

@if (!Session.IsAdmin)
{
    <section class="card">
        <p class="error">Раздел доступен только администратору.</p>
        <a class="button button-light" href="/shelter">Вернуться к приюту</a>
    </section>
}
else
{
    <section class="card">
        <h2>Сводка</h2>
        <div class="report-list">
            <p><span>Животных в приюте</span><b>@AnimalStore.Animals.Count</b></p>
            <p><span>Отданы в семьи</span><b>@AnimalStore.AdoptedCount</b></p>
            <p><span>На лечении</span><b>@AnimalStore.Animals.Count(a => a.Status == "На лечении")</b></p>
            <p><span>Ожидают семью</span><b>@AnimalStore.Animals.Count(a => a.Status == "Ожидает семью")</b></p>
            <p><span>Всего заявок</span><b>@RequestStore.Requests.Count</b></p>
            <p><span>Ветеринарных записей</span><b>@VeterinaryStore.Records.Count</b></p>
        </div>
    </section>
}
