@page "/shelter"
@inject UserSession Session

<PageTitle>Приют</PageTitle>

<div class="page-heading">
    <h1>Приют для животных</h1>
    <p>Список питомцев и основные сведения о приюте.</p>
</div>

<div class="action-row">
    @if (Session.IsAdmin || Session.IsVolunteer)
    {
        <a class="button" href="/animals/new">Добавить животное</a>
    }
    @if (Session.CurrentUser is not null)
    {
        <a class="button button-light" href="/requests">Открыть заявки</a>
    }
    @if (Session.IsVeterinarian)
    {
        <a class="button button-light" href="/veterinary">Ветеринарный журнал</a>
    }
    @if (Session.IsAdmin)
    {
        <a class="button button-light" href="/reports">Отчёт</a>
    }
</div>

<div class="stats-grid">
    <div class="stat"><strong>@AnimalStore.Animals.Count</strong><span>Животных в приюте</span></div>
    <div class="stat"><strong>@AnimalStore.AdoptedCount</strong><span>Отданы в семьи</span></div>
    <div class="stat"><strong>@AnimalStore.Animals.Count(a => a.Status == "На лечении")</strong><span>На лечении</span></div>
    <div class="stat"><strong>@AnimalStore.Animals.Count(a => a.Status == "Ожидает семью")</strong><span>Ожидают семью</span></div>
</div>

<section class="card">
    <div class="section-heading">
        <div>
            <h2>Список животных</h2>
            <p class="muted">Найдено: @FilteredAnimals.Count</p>
        </div>
        <input class="search-input" placeholder="Поиск по кличке или номеру"
               @bind="Search" @bind:event="oninput" />
    </div>

    @if (FilteredAnimals.Count == 0)
    {
        <p class="muted">Животные не найдены.</p>
    }
    else
    {
        <div class="animal-list">
            @foreach (var animal in FilteredAnimals)
            {
                <article class="animal-row">
                    <div>
                        <h3>@animal.Name</h3>
                        <p class="muted">@animal.Number · @animal.Species · @animal.Breed</p>
                        <p class="muted">@animal.Gender · @animal.Age · @animal.Weight</p>
                    </div>
                    <div class="animal-side">
                        <span class="status">@animal.Status</span>
                        <button class="text-button" @onclick="() => SelectAnimal(animal)">Подробнее</button>
                    </div>
                </article>
            }
        </div>
    }
</section>

@if (SelectedAnimal is not null)
{
    <section class="card">
        <div class="section-heading">
            <h2>@SelectedAnimal.Name</h2>
            <button class="text-button" @onclick="CloseDetails">Закрыть</button>
        </div>
        <div class="details-grid">
            <p><b>Номер:</b> @SelectedAnimal.Number</p>
            <p><b>Вид:</b> @SelectedAnimal.Species</p>
            <p><b>Порода:</b> @SelectedAnimal.Breed</p>
            <p><b>Пол:</b> @SelectedAnimal.Gender</p>
            <p><b>Окрас:</b> @SelectedAnimal.Color</p>
            <p><b>Размер:</b> @SelectedAnimal.Size</p>
            <p><b>Возраст:</b> @SelectedAnimal.Age</p>
            <p><b>Вес:</b> @SelectedAnimal.Weight</p>
            <p><b>Прививки:</b> @SelectedAnimal.Vaccinations</p>
            <p><b>Статус:</b> @SelectedAnimal.Status</p>
        </div>
    </section>
}

@code {
    private string Search { get; set; } = "";
    private AnimalItem? SelectedAnimal { get; set; }

    private List<AnimalItem> FilteredAnimals =>
        AnimalStore.Animals
            .Where(a => string.IsNullOrWhiteSpace(Search)
                || a.Name.Contains(Search, StringComparison.OrdinalIgnoreCase)
                || a.Number.Contains(Search, StringComparison.OrdinalIgnoreCase))
            .ToList();

    private void SelectAnimal(AnimalItem animal) => SelectedAnimal = animal;
    private void CloseDetails() => SelectedAnimal = null;
}
