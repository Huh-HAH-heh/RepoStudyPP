<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="StudyMauiApp.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Главная"
    BackgroundColor="#F3F4F4">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <VerticalStackLayout Spacing="4">
                <Label Text="Учебные работы"
                       FontSize="26"
                       FontAttributes="Bold"
                       TextColor="#252525" />
                <Label Text="Небольшие приложения на .NET MAUI"
                       FontSize="14"
                       TextColor="#666666" />
            </VerticalStackLayout>

            <Border BackgroundColor="White"
                    Stroke="#D6D6D6"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 5"
                    Padding="16">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Работа 1. Главная страница"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#252525" />
                    <Label Text="Простой экран с описанием учебных проектов. Здесь собраны переходы к основным разделам приложения."
                           FontSize="14"
                           TextColor="#555555" />
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="White"
                    Stroke="#D6D6D6"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 5"
                    Padding="16">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Работа 2. Учёт животных в приюте"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#252525" />
                    <Label Text="В этой части можно просматривать список животных, оформлять заявки и вести журнал ветеринарных записей."
                           FontSize="14"
                           TextColor="#555555" />
                    <Button Text="Открыть приют"
                            Clicked="OnOpenShelterClicked"
                            BackgroundColor="#456C83"
                            TextColor="White"
                            CornerRadius="4"
                            HeightRequest="42"
                            HorizontalOptions="Start"
                            Padding="18,8" />
                </VerticalStackLayout>
            </Border>

            <Label Text="Данные в приложении учебные и хранятся только во время его работы."
                   FontSize="12"
                   TextColor="#777777" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>