<Window x:Class="RepoStudyPP.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Учебные работы — учёт животных"
        Width="1100" Height="760"
        MinWidth="850" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBackground}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#E6EAEC" Padding="16,10"
                BorderBrush="#D0D5D8" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Учебные работы" FontSize="19" FontWeight="Bold" />
                    <TextBlock Text="C# и XAML" Foreground="{StaticResource MutedColor}" FontSize="12" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Content="Главная" Click="HomeNav_Click" />
                    <Button Content="Приют" Click="ShelterNav_Click" />
                    <Button x:Name="RequestsNavButton" Content="Заявки"
                            Click="RequestsNav_Click" Visibility="Collapsed" />
                    <Button x:Name="VeterinaryNavButton" Content="Ветеринария"
                            Click="VeterinaryNav_Click" Visibility="Collapsed" />
                    <Button x:Name="ReportsNavButton" Content="Отчёт"
                            Click="ReportsNav_Click" Visibility="Collapsed" />
                    <Button x:Name="AddAnimalNavButton" Content="Добавить животное"
                            Click="AddAnimalNav_Click" Visibility="Collapsed" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="CurrentUserText" VerticalAlignment="Center"
                               Margin="0,0,8,0" Foreground="#555555" />
                    <Button x:Name="AccountButton" Content="Войти" Click="AccountButton_Click"
                            Background="#E1E4E5" Foreground="#252525" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="18">

            <!-- Start page -->
            <Grid x:Name="HomePage" Visibility="Visible">
                <StackPanel Width="760" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <TextBlock Text="Учебные работы" FontSize="28" FontWeight="Bold"
                               Margin="0,0,0,4" />
                    <TextBlock Text="Небольшие приложения, выполненные на C# и XAML."
                               Foreground="{StaticResource MutedColor}" Margin="0,0,0,18" />

                    <Border Background="White" BorderBrush="#D6D6D6" BorderThickness="1"
                            Padding="18" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Работа 1. Главная страница" FontSize="19"
                                       FontWeight="Bold" Margin="0,0,0,8" />
                            <TextBlock Text="Стартовая страница учебного проекта. Здесь собраны переходы к основным разделам приложения."
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Background="White" BorderBrush="#D6D6D6" BorderThickness="1"
                            Padding="18">
                        <StackPanel>
                            <TextBlock Text="Работа 2. Учёт животных в приюте" FontSize="19"
                                       FontWeight="Bold" Margin="0,0,0,8" />
                            <TextBlock Text="Просмотр животных, оформление заявок и ведение ветеринарного журнала."
                                       TextWrapping="Wrap" Margin="0,0,0,10" />
                            <Button Content="Открыть приют" Click="ShelterNav_Click"
                                    HorizontalAlignment="Left" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Данные демонстрационные и хранятся только во время работы приложения."
                               Foreground="{StaticResource MutedColor}" FontSize="12"
                               Margin="0,14,0,0" />
                </StackPanel>
            </Grid>

            <!-- Shelter page -->
            <Grid x:Name="ShelterPage" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,14">
                    <TextBlock Text="Приют для животных" FontSize="27" FontWeight="Bold" />
                    <TextBlock Text="Список питомцев и основные сведения о приюте."
                               Foreground="{StaticResource MutedColor}" />
                </StackPanel>

                <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,14">
                    <Border Background="White" BorderBrush="#D6D6D6" BorderThickness="1"
                            Padding="12" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock x:Name="AnimalsCountText" FontSize="25"
                                       FontWeight="Bold" Foreground="{StaticResource AccentColor}" />
                            <TextBlock Text="Животных в приюте" FontSize="12" />
                        </StackPanel>
                    </Border>
                    <Border Background="White" BorderBrush="#D6D6D6" BorderThickness="1"
                            Padding="12" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock x:Name="AdoptedCountText" FontSize="25"
                                       FontWeight="Bold" Foreground="{StaticResource AccentColor}" />
                            <TextBlock Text="Отданы в семьи" FontSize="12" />
                        </StackPanel>
                    </Border>
                    <Border Background="White" BorderBrush="#D6D6D6" BorderThickness="1"
                            Padding="12" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock x:Name="TreatmentCountText" FontSize="25"
                                       FontWeight="Bold" Foreground="{StaticResource AccentColor}" />
                            <TextBlock Text="На лечении" FontSize="12" />
                        </StackPanel>
                    </Border>
                    <Border Background="White" BorderBrush="#D6D6D6" BorderThickness="1"
                            Padding="12">
                        <StackPanel>
                            <TextBlock x:Name="WaitingCountText" FontSize="25"
                                       FontWeight="Bold" Foreground="{StaticResource AccentColor}" />
                            <TextBlock Text="Ожидают семью" FontSize="12" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.15*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="White" BorderBrush="#D6D6D6"
                            BorderThickness="1" Padding="12" Margin="0,0,10,0">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top">
                                <TextBlock Text="Список животных" FontWeight="Bold"
                                           FontSize="18" Margin="0,0,0,8" />
                                <TextBox x:Name="AnimalSearchBox" ToolTip="Поиск по кличке или номеру"
                                         TextChanged="AnimalSearchBox_TextChanged" />
                                <TextBlock x:Name="AnimalCountLabel" Foreground="{StaticResource MutedColor}"
                                           FontSize="12" Margin="0,0,0,6" />
                            </StackPanel>
                            <ListBox x:Name="AnimalsList" SelectionChanged="AnimalsList_SelectionChanged"
                                     BorderThickness="0" Background="Transparent">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#DDDDDD" BorderThickness="0,0,0,1"
                                                Padding="8,9">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="15" />
                                                <TextBlock Text="{Binding Number}" Foreground="#666666" FontSize="12" />
                                                <TextBlock Text="{Binding Details}" Foreground="#666666" FontSize="12" />
                                                <TextBlock Text="{Binding Status}" Foreground="{StaticResource AccentColor}"
                                                           FontSize="12" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="1" Background="White" BorderBrush="#D6D6D6"
                            BorderThickness="1" Padding="16">
                        <StackPanel>
                            <TextBlock Text="Карточка животного" FontSize="18" FontWeight="Bold"
                                       Margin="0,0,0,12" />
                            <TextBlock x:Name="AnimalDetailsText" Text="Выберите животное из списка."
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- Login page -->
            <Grid x:Name="LoginPage" Visibility="Collapsed">
                <Border Width="420" Padding="22" Background="White" BorderBrush="#D6D6D6"
                        BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Вход в систему" FontSize="23" FontWeight="Bold"
                                   Margin="0,0,0,5" />
                        <TextBlock Text="Введите логин и пароль учебной учётной записи."
                                   Foreground="{StaticResource MutedColor}" Margin="0,0,0,12" />
                        <TextBlock Text="Логин" />
                        <TextBox x:Name="LoginBox" />
                        <TextBlock Text="Пароль" />
                        <PasswordBox x:Name="PasswordBox" Margin="0,3,0,8" Padding="7,5" />
                        <TextBlock x:Name="LoginErrorText" Foreground="#A53131"
                                   TextWrapping="Wrap" Margin="0,0,0,8" />
                        <Button Content="Войти" Click="LoginButton_Click"
                                HorizontalAlignment="Left" />
                        <TextBlock Text="Тестовые учётные записи:" FontWeight="Bold"
                                   Margin="0,16,0,4" />
                        <TextBlock Text="Администратор: Nerd / Nerd" />
                        <TextBlock Text="Клиент: GOON / GOON" />
                        <TextBlock Text="Волонтёр: WERDO / WERDO" />
                        <TextBlock Text="Ветеринар: vet / vet" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Add animal page -->
            <Grid x:Name="AddAnimalPage" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Border Width="560" Padding="18" Background="White"
                            BorderBrush="#D6D6D6" BorderThickness="1"
                            HorizontalAlignment="Left" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="Добавить животное" FontSize="23" FontWeight="Bold" />
                            <TextBlock Text="Заполните основные сведения для журнала приюта."
                                       Foreground="{StaticResource MutedColor}" Margin="0,2,0,12" />

                            <TextBlock Text="Кличка *" /><TextBox x:Name="NewAnimalNameBox" />
                            <TextBlock Text="Номер *" /><TextBox x:Name="NewAnimalNumberBox" />
                            <TextBlock Text="Вид животного" />
                            <ComboBox x:Name="NewAnimalSpeciesBox" SelectedIndex="0">
                                <ComboBoxItem Content="Собака" />
                                <ComboBoxItem Content="Кошка" />
                                <ComboBoxItem Content="Другое" />
                            </ComboBox>
                            <TextBlock Text="Пол" />
                            <ComboBox x:Name="NewAnimalGenderBox" SelectedIndex="0">
                                <ComboBoxItem Content="Самка" />
                                <ComboBoxItem Content="Самец" />
                            </ComboBox>
                            <TextBlock Text="Порода" /><TextBox x:Name="NewAnimalBreedBox" />
                            <TextBlock Text="Размер" />
                            <ComboBox x:Name="NewAnimalSizeBox" SelectedIndex="1">
                                <ComboBoxItem Content="Маленький" />
                                <ComboBoxItem Content="Средний" />
                                <ComboBoxItem Content="Крупный" />
                            </ComboBox>

                            <TextBlock x:Name="AddAnimalErrorText" Foreground="#A53131"
                                       TextWrapping="Wrap" Margin="0,2,0,6" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Сохранить" Click="SaveAnimalButton_Click" />
                                <Button Content="Отмена" Click="ShelterNav_Click"
                                        Background="#E1E4E5" Foreground="#252525" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </Grid>

            <!-- Requests page -->
            <Grid x:Name="RequestsPage" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.9*" />
                    <ColumnDefinition Width="1.1*" />
                </Grid.ColumnDefinitions>

                <Border x:Name="RequestFormCard" Grid.Column="0" Background="White" BorderBrush="#D6D6D6"
                        BorderThickness="1" Padding="16" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Новая заявка" FontSize="21" FontWeight="Bold"
                                   Margin="0,0,0,10" />
                        <TextBlock Text="Тип заявки" />
                        <ComboBox x:Name="RequestTypeBox" SelectedIndex="0"
                                  SelectionChanged="RequestTypeBox_SelectionChanged">
                            <ComboBoxItem Content="Взять животное в семью" Tag="Adoption" />
                            <ComboBoxItem Content="Передать животное в приют" Tag="Surrender" />
                        </ComboBox>

                        <StackPanel x:Name="AdoptionRequestFields">
                            <TextBlock Text="Питомец" />
                            <ComboBox x:Name="RequestAnimalBox" DisplayMemberPath="DisplayName" />
                        </StackPanel>

                        <StackPanel x:Name="SurrenderRequestFields" Visibility="Collapsed">
                            <TextBlock Text="Опишите животное" />
                            <TextBox x:Name="SurrenderDescriptionBox" Height="80"
                                     TextWrapping="Wrap" AcceptsReturn="True" />
                        </StackPanel>

                        <TextBlock Text="Дата заявки (ДД.ММ.ГГГГ)" />
                        <TextBox x:Name="RequestDateBox" />
                        <TextBlock x:Name="RequestErrorText" Foreground="#A53131"
                                   TextWrapping="Wrap" />
                        <Button x:Name="CreateRequestButton" Content="Оформить заявку" Click="CreateRequestButton_Click"
                                HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="White" BorderBrush="#D6D6D6"
                        BorderThickness="1" Padding="16">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="Журнал заявок" FontSize="21" FontWeight="Bold" />
                            <TextBlock x:Name="RequestsCountLabel" Foreground="{StaticResource MutedColor}"
                                       FontSize="12" Margin="0,2,0,8" />
                        </StackPanel>
                        <ListBox x:Name="RequestsList" SelectionChanged="RequestsList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Type}" FontWeight="Bold" />
                                            <TextBlock Text="{Binding ClientName}" />
                                            <TextBlock Text="{Binding Phone}" Foreground="#666666" FontSize="12" />
                                            <TextBlock Text="{Binding AnimalText}" Foreground="#666666"
                                                       FontSize="12" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding DateText}" Foreground="#666666" FontSize="12" />
                                            <TextBlock Text="{Binding Status}" Foreground="{StaticResource AccentColor}"
                                                       FontSize="12" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Button x:Name="ProcessRequestButton" DockPanel.Dock="Bottom"
                                Content="Оформить выдачу выбранного животного"
                                Click="ProcessRequestButton_Click" Visibility="Collapsed" />
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Veterinary page -->
            <Grid x:Name="VeterinaryPage" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.9*" />
                    <ColumnDefinition Width="1.1*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="White" BorderBrush="#D6D6D6"
                        BorderThickness="1" Padding="16" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Новая ветеринарная запись" FontSize="21"
                                   FontWeight="Bold" Margin="0,0,0,10" />
                        <TextBlock Text="Животное" />
                        <ComboBox x:Name="VetAnimalBox" DisplayMemberPath="DisplayName" />
                        <TextBlock Text="Дата (ДД.ММ.ГГГГ)" />
                        <TextBox x:Name="VetDateBox" />
                        <TextBlock Text="Процедура" />
                        <TextBox x:Name="VetProcedureBox" />
                        <TextBlock Text="Примечание" />
                        <TextBox x:Name="VetNotesBox" Height="75" TextWrapping="Wrap"
                                 AcceptsReturn="True" />
                        <TextBlock x:Name="VetErrorText" Foreground="#A53131"
                                   TextWrapping="Wrap" />
                        <Button x:Name="SaveVetButton" Content="Сохранить запись"
                                Click="SaveVetButton_Click" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="White" BorderBrush="#D6D6D6"
                        BorderThickness="1" Padding="16">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="Ветеринарный журнал" FontSize="21"
                                       FontWeight="Bold" />
                            <TextBlock x:Name="VetRecordsCountLabel" Foreground="{StaticResource MutedColor}"
                                       FontSize="12" Margin="0,2,0,8" />
                        </StackPanel>
                        <ListBox x:Name="VetRecordsList">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Procedure}" FontWeight="Bold" />
                                            <TextBlock Text="{Binding AnimalText}" FontSize="12" />
                                            <TextBlock Text="{Binding DateText}" Foreground="#666666" FontSize="12" />
                                            <TextBlock Text="{Binding Notes}" Foreground="#666666"
                                                       FontSize="12" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Reports page -->
            <Grid x:Name="ReportsPage" Visibility="Collapsed">
                <Border Width="540" Padding="18" Background="White" BorderBrush="#D6D6D6"
                        BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Отчёт приюта" FontSize="24" FontWeight="Bold"
                                   Margin="0,0,0,12" />
                        <TextBlock x:Name="ReportAnimalsText" Margin="0,4" />
                        <TextBlock x:Name="ReportAdoptedText" Margin="0,4" />
                        <TextBlock x:Name="ReportTreatmentText" Margin="0,4" />
                        <TextBlock x:Name="ReportWaitingText" Margin="0,4" />
                        <TextBlock x:Name="ReportRequestsText" Margin="0,4" />
                        <TextBlock x:Name="ReportVetText" Margin="0,4" />
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock x:Name="GlobalMessageText" VerticalAlignment="Bottom"
                       HorizontalAlignment="Left" Foreground="{StaticResource AccentColor}"
                       Margin="4,0,0,4" />
        </Grid>
    </Grid>
</Window>