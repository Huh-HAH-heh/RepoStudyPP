<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="StudyMauiApp.RequestsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Заявки"
    BackgroundColor="#F3F4F4">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">
            <VerticalStackLayout Spacing="3">
                <Label Text="Заявки"
                       FontSize="23"
                       FontAttributes="Bold"
                       TextColor="#252525" />
                <Label x:Name="PageSubtitle"
                       Text="Заявки на передачу и приём животных."
                       FontSize="13"
                       TextColor="#666666" />
            </VerticalStackLayout>

            <Border x:Name="CreateRequestCard"
                    BackgroundColor="White"
                    Stroke="#D6D6D6"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 5"
                    Padding="16">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Новая заявка"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#252525" />

                    <Label Text="ФИО клиента" FontSize="13" TextColor="#555555" />
                    <Entry x:Name="ClientNameEntry" IsReadOnly="True" />

                    <Label Text="Телефон" FontSize="13" TextColor="#555555" />
                    <Entry x:Name="PhoneEntry" IsReadOnly="True" />

                    <Label Text="Тип заявки" FontSize="13" TextColor="#555555" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button x:Name="AdoptionTypeButton"
                                Text="Взять в семью"
                                Clicked="OnAdoptionTypeClicked"
                                BackgroundColor="#456C83"
                                TextColor="White"
                                CornerRadius="4"
                                HeightRequest="42" />
                        <Button Grid.Column="1"
                                x:Name="SurrenderTypeButton"
                                Text="Передать в приют"
                                Clicked="OnSurrenderTypeClicked"
                                BackgroundColor="#E1E4E5"
                                TextColor="#252525"
                                CornerRadius="4"
                                HeightRequest="42" />
                    </Grid>

                    <VerticalStackLayout x:Name="AdoptionFields" Spacing="6">
                        <Label Text="Выберите питомца" FontSize="13" TextColor="#555555" />
                        <VerticalStackLayout x:Name="AnimalOptions" Spacing="6" />
                        <Label x:Name="SelectedAnimalLabel"
                               Text="Питомец не выбран"
                               FontSize="12"
                               TextColor="#666666" />
                    </VerticalStackLayout>

                    <VerticalStackLayout x:Name="SurrenderFields"
                                         Spacing="6"
                                         IsVisible="False">
                        <Label Text="Опишите животное" FontSize="13" TextColor="#555555" />
                        <Editor x:Name="SurrenderAnimalEntry"
                                Placeholder="Вид, примерный возраст и другие сведения"
                                AutoSize="TextChanges"
                                MinimumHeightRequest="80" />
                    </VerticalStackLayout>

                    <Label Text="Дата заявки" FontSize="13" TextColor="#555555" />
                    <DatePicker x:Name="RequestDatePicker"
                                Format="dd.MM.yyyy" />

                    <Label x:Name="ValidationLabel"
                           IsVisible="False"
                           TextColor="#B33A3A"
                           FontSize="12" />

                    <Button Text="Оформить заявку"
                            Clicked="OnCreateRequestClicked"
                            BackgroundColor="#456C83"
                            TextColor="White"
                            CornerRadius="4"
                            HeightRequest="42" />
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="White"
                    Stroke="#D6D6D6"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 5"
                    Padding="16">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Журнал заявок"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="#252525" />
                            <Label x:Name="RequestsCountLabel"
                                   FontSize="12"
                                   TextColor="#666666" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1"
                                Text="Назад"
                                Clicked="OnBackClicked"
                                BackgroundColor="#E1E4E5"
                                TextColor="#252525"
                                CornerRadius="4" />
                    </Grid>

                    <CollectionView x:Name="RequestsView"
                                    SelectionMode="None">
                        <CollectionView.EmptyView>
                            <Label Text="Заявок пока нет."
                                   TextColor="#666666"
                                   HorizontalTextAlignment="Center"
                                   Margin="0,18" />
                        </CollectionView.EmptyView>

                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8"
                                        Padding="10"
                                        BackgroundColor="#F7F8F8"
                                        Stroke="#DDDDDD"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 4">
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="{Binding Type}"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               TextColor="#252525" />
                                        <Label Text="{Binding ClientName}"
                                               FontSize="13"
                                               TextColor="#252525" />
                                        <Label Text="{Binding Phone}"
                                               FontSize="12"
                                               TextColor="#666666" />
                                        <Label Text="{Binding AnimalText}"
                                               FontSize="12"
                                               TextColor="#666666" />
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Text="{Binding DateText}"
                                                   FontSize="12"
                                                   TextColor="#666666"
                                                   VerticalTextAlignment="Center" />
                                            <Label Grid.Column="1"
                                                   Text="{Binding Status}"
                                                   FontSize="12"
                                                   TextColor="#456C83"
                                                   VerticalTextAlignment="Center" />
                                        </Grid>
                                        <Button Text="Оформить выдачу"
                                                IsVisible="{Binding CanProcess}"
                                                Clicked="OnProcessClicked"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="#456C83"
                                                TextColor="White"
                                                CornerRadius="4"
                                                HeightRequest="38"
                                                HorizontalOptions="Start" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>