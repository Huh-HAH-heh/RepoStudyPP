<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="StudyMauiApp.ShelterMainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Приют"
    BackgroundColor="#F3F4F4">

    <ContentPage.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="BackgroundColor" Value="White" />
            <Setter Property="Stroke" Value="#D6D6D6" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="StrokeShape" Value="RoundRectangle 5" />
            <Setter Property="Padding" Value="12" />
        </Style>

        <Style x:Key="Muted" TargetType="Label">
            <Setter Property="TextColor" Value="#666666" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="#456C83" />
            <Setter Property="TextColor" Value="White" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="FontSize" Value="13" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0"
                BackgroundColor="#E6EAEC"
                StrokeThickness="0"
                Padding="14">
            <VerticalStackLayout Spacing="10">
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Приют для животных"
                               FontSize="22"
                               FontAttributes="Bold"
                               TextColor="#252525" />
                        <Label Text="Учёт питомцев и заявок"
                               FontSize="12"
                               TextColor="#666666" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Column="1"
                                         x:Name="UserInfo"
                                         Spacing="1"
                                         VerticalOptions="Center">
                        <Label x:Name="CurrentUserLabel"
                               TextColor="#252525"
                               FontSize="12"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="End"
                               IsVisible="False" />
                        <Label x:Name="CurrentRoleLabel"
                               TextColor="#666666"
                               FontSize="11"
                               HorizontalTextAlignment="End"
                               IsVisible="False" />
                        <Button x:Name="LoginButton"
                                Text="Войти"
                                FontSize="12"
                                Padding="12,5"
                                CornerRadius="4"
                                BackgroundColor="#456C83"
                                TextColor="White" />
                    </VerticalStackLayout>
                </Grid>

                <ScrollView Orientation="Horizontal"
                            HorizontalScrollBarVisibility="Never">
                    <HorizontalStackLayout Spacing="8">
                        <Button Text="Главная"
                                Clicked="OnHomeClicked"
                                Style="{StaticResource ToolButton}" />
                        <Button x:Name="RequestsNavButton"
                                Text="Заявки"
                                Clicked="OnRequestsClicked"
                                Style="{StaticResource ToolButton}"
                                IsVisible="False" />
                        <Button x:Name="ReportsNavButton"
                                Text="Отчёт"
                                Clicked="OnReportsClicked"
                                Style="{StaticResource ToolButton}"
                                IsVisible="False" />
                        <Button x:Name="AddAnimalButton"
                                Text="Добавить животное"
                                Clicked="OnAddAnimalClicked"
                                Style="{StaticResource ToolButton}"
                                IsVisible="False" />
                        <Button x:Name="RequestButton"
                                Text="Новая заявка"
                                Clicked="OnAddRequestClicked"
                                Style="{StaticResource ToolButton}"
                                IsVisible="False" />
                        <Button x:Name="VetButton"
                                Text="Ветеринария"
                                Clicked="OnVetClicked"
                                Style="{StaticResource ToolButton}"
                                IsVisible="False" />
                    </HorizontalStackLayout>
                </ScrollView>
            </VerticalStackLayout>
        </Border>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16" Spacing="12">

                <Label Text="Краткая информация"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="#252525" />

                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto"
                      ColumnSpacing="8" RowSpacing="8">
                    <Border Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="3">
                            <Label x:Name="AnimalsCountLabel"
                                   FontSize="24"
                                   FontAttributes="Bold"
                                   TextColor="#456C83" />
                            <Label Text="Животных в приюте" Style="{StaticResource Muted}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="3">
                            <Label x:Name="AdoptedCountLabel"
                                   FontSize="24"
                                   FontAttributes="Bold"
                                   TextColor="#456C83" />
                            <Label Text="Отданы в семьи" Style="{StaticResource Muted}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="1" Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="3">
                            <Label x:Name="TreatmentCountLabel"
                                   FontSize="24"
                                   FontAttributes="Bold"
                                   TextColor="#456C83" />
                            <Label Text="На лечении" Style="{StaticResource Muted}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="3">
                            <Label x:Name="WaitingCountLabel"
                                   FontSize="24"
                                   FontAttributes="Bold"
                                   TextColor="#456C83" />
                            <Label Text="Ожидают семью" Style="{StaticResource Muted}" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Список животных"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="#252525" />
                        <SearchBar x:Name="SearchBox"
                                   Placeholder="Поиск по кличке или номеру"
                                   TextChanged="OnFilterChanged" />
                        <Label x:Name="ResultsLabel"
                               Text="Найдено: 0"
                               Style="{StaticResource Muted}" />

                        <CollectionView x:Name="AnimalsView"
                                        SelectionMode="Single"
                                        SelectionChanged="OnAnimalSelected">
                            <CollectionView.EmptyView>
                                <Label Text="Животные не найдены."
                                       TextColor="#666666"
                                       HorizontalTextAlignment="Center"
                                       Margin="0,20" />
                            </CollectionView.EmptyView>

                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8"
                                            Padding="10"
                                            BackgroundColor="#F7F8F8"
                                            Stroke="#DDDDDD"
                                            StrokeThickness="1"
                                            StrokeShape="RoundRectangle 4">
                                        <Grid ColumnDefinitions="*,Auto"
                                              ColumnSpacing="10">
                                            <VerticalStackLayout Spacing="3">
                                                <Label Text="{Binding Name}"
                                                       FontSize="15"
                                                       FontAttributes="Bold"
                                                       TextColor="#252525" />
                                                <Label Text="{Binding Number}"
                                                       FontSize="12"
                                                       TextColor="#666666" />
                                                <Label Text="{Binding Details}"
                                                       FontSize="12"
                                                       TextColor="#666666" />
                                            </VerticalStackLayout>
                                            <VerticalStackLayout Grid.Column="1"
                                                                 Spacing="3"
                                                                 VerticalOptions="Center"
                                                                 HorizontalOptions="End">
                                                <Label Text="{Binding Status}"
                                                       FontSize="12"
                                                       TextColor="#456C83"
                                                       HorizontalTextAlignment="End" />
                                                <Label Text="{Binding Weight}"
                                                       FontSize="11"
                                                       TextColor="#777777"
                                                       HorizontalTextAlignment="End" />
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

                <Label Text="Чтобы посмотреть подробности, выберите животное в списке."
                       FontSize="12"
                       TextColor="#777777" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>