<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="StudyMauiApp.VeterinaryPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Ветеринария"
    BackgroundColor="#F3F4F4">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">
            <VerticalStackLayout Spacing="3">
                <Label Text="Ветеринарный журнал"
                       FontSize="23"
                       FontAttributes="Bold"
                       TextColor="#252525" />
                <Label x:Name="PageSubtitle"
                       Text="Записи о медицинских манипуляциях."
                       FontSize="13"
                       TextColor="#666666" />
            </VerticalStackLayout>

            <Border x:Name="CreateRecordCard"
                    BackgroundColor="White"
                    Stroke="#D6D6D6"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 5"
                    Padding="16">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Новая запись"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#252525" />

                    <Label Text="Животное" FontSize="13" TextColor="#555555" />
                    <VerticalStackLayout x:Name="AnimalOptions" Spacing="6" />
                    <Label x:Name="SelectedAnimalLabel"
                           Text="Животное не выбрано"
                           FontSize="12"
                           TextColor="#666666" />

                    <Label Text="Дата (ДД.ММ.ГГГГ)" FontSize="13" TextColor="#555555" />
                    <Entry x:Name="DateEntry" Placeholder="05.11.2026" />

                    <Label Text="Процедура" FontSize="13" TextColor="#555555" />
                    <Entry x:Name="ProcedureEntry" Placeholder="Например: осмотр" />

                    <Label Text="Примечание" FontSize="13" TextColor="#555555" />
                    <Editor x:Name="NotesEditor"
                            Placeholder="Краткие сведения"
                            AutoSize="TextChanges"
                            MinimumHeightRequest="75" />

                    <Label x:Name="ValidationLabel"
                           IsVisible="False"
                           TextColor="#B33A3A"
                           FontSize="12" />

                    <Button Text="Сохранить запись"
                            Clicked="OnSaveClicked"
                            BackgroundColor="#456C83"
                            TextColor="White"
                            CornerRadius="4"
                            HeightRequest="42" />
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="White"
                    Stroke="#D6D6D6"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 5"
                    Padding="16">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Список записей"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="#252525" />
                            <Label x:Name="RecordsCountLabel"
                                   FontSize="12"
                                   TextColor="#666666" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1"
                                Text="Назад"
                                Clicked="OnBackClicked"
                                BackgroundColor="#E1E4E5"
                                TextColor="#252525"
                                CornerRadius="4" />
                    </Grid>

                    <CollectionView x:Name="RecordsView"
                                    SelectionMode="None">
                        <CollectionView.EmptyView>
                            <Label Text="Записей пока нет."
                                   TextColor="#666666"
                                   HorizontalTextAlignment="Center"
                                   Margin="0,18" />
                        </CollectionView.EmptyView>

                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8"
                                        Padding="10"
                                        BackgroundColor="#F7F8F8"
                                        Stroke="#DDDDDD"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 4">
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="{Binding Procedure}"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               TextColor="#252525" />
                                        <Label Text="{Binding AnimalText}"
                                               FontSize="12"
                                               TextColor="#666666" />
                                        <Label Text="{Binding DateText}"
                                               FontSize="12"
                                               TextColor="#666666" />
                                        <Label Text="{Binding Notes}"
                                               FontSize="12"
                                               TextColor="#666666" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>